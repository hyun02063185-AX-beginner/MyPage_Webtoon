generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  concept   String
  audience  String
  purpose   String
  style     String
  memo      String?
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Term {
  id            String   @id @default(cuid())
  term          String
  normalizedKey String   @unique
  definition    String
  category      String
  source        String   @default("CURATED_20260906")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([term])
  @@index([category])
}
