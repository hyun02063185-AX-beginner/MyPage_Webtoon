generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                        String            @id @default(cuid())
  concept                   String
  slug                      String?           @unique
  title                     String?
  imageAlt                  String?
  paragraphsJson            String?
  audience                  String
  purpose                   String
  style                     String
  memo                      String?
  status                    String            @default("DRAFT")
  selectedScenarioVersionId String?           @unique
  selectedScenarioVersion   ScenarioVersion?  @relation("SelectedScenarioVersion", fields: [selectedScenarioVersionId], references: [id])
  scenarioVersions          ScenarioVersion[] @relation("ProjectScenarioVersions")
  imageAttempts             ImageAttempt[]    @relation("ProjectImageAttempts")
  selectedImageAttemptId    String?           @unique
  selectedImageAttempt      ImageAttempt?     @relation("SelectedImageAttempt", fields: [selectedImageAttemptId], references: [id])
  exportBundles             ExportBundle[]
  generationLock            GenerationLock?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
}

model ScenarioVersion {
  id                String    @id @default(cuid())
  projectId         String
  version           Int
  term              String
  english           String?
  title             String
  audience          String
  coreMessage       String
  background        String
  characterGuide    String
  panelsJson        String
  finalCaption      String
  sourceModel       String
  sourceResponseId  String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  project           Project   @relation("ProjectScenarioVersions", fields: [projectId], references: [id], onDelete: Restrict)
  selectedForProject Project? @relation("SelectedScenarioVersion")
  imageAttempts      ImageAttempt[] @relation("ScenarioImageAttempts")

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

model ImageAttempt {
  id                    String          @id @default(cuid())
  projectId             String
  scenarioVersionId     String
  parentAttemptId       String?
  idempotencyKey        String          @unique
  promptSnapshot        String
  promptHash            String
  requestedModel        String
  responseModel         String?
  providerRequestId     String?
  size                  String
  quality               String
  outputFormat          String
  outputCompression     Int?
  status                String          @default("QUEUED")
  isMock                Boolean         @default(true)
  filePath              String?
  fileSha256            String?
  regenerationMode      String          @default("ORIGINAL")
  regenerationReason    String?
  errorCode             String?
  safeErrorMessage      String?
  createdAt             DateTime        @default(now())
  completedAt           DateTime?
  project               Project         @relation("ProjectImageAttempts", fields: [projectId], references: [id], onDelete: Restrict)
  scenarioVersion       ScenarioVersion @relation("ScenarioImageAttempts", fields: [scenarioVersionId], references: [id], onDelete: Restrict)
  parentAttempt         ImageAttempt?   @relation("AttemptRegenerations", fields: [parentAttemptId], references: [id], onDelete: Restrict)
  regeneratedAttempts   ImageAttempt[]  @relation("AttemptRegenerations")
  imageReview           ImageReview?
  selectedForProject    Project?        @relation("SelectedImageAttempt")
  exportBundles         ExportBundle[]

  @@index([projectId, createdAt])
  @@index([scenarioVersionId])
  @@index([parentAttemptId])
}

model ExportBundle {
  id             String       @id @default(cuid())
  projectId      String
  imageAttemptId String
  exportVersion  Int
  imagePath      String
  jsonPath       String
  archivePath    String?
  imageSha256    String
  jsonSha256     String
  createdAt      DateTime     @default(now())
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  imageAttempt   ImageAttempt @relation(fields: [imageAttemptId], references: [id], onDelete: Restrict)

  @@unique([projectId, exportVersion])
  @@index([imageAttemptId, createdAt])
}

model ImageReview {
  id              String       @id @default(cuid())
  imageAttemptId  String       @unique
  result          String
  panelChecksJson String
  typoFound       Boolean      @default(false)
  missingText     Boolean      @default(false)
  croppedText     Boolean      @default(false)
  layoutIssue     Boolean      @default(false)
  contentIssue    Boolean      @default(false)
  notes           String?
  reviewedAt      DateTime     @default(now())
  imageAttempt    ImageAttempt @relation(fields: [imageAttemptId], references: [id], onDelete: Restrict)

  @@index([result, reviewedAt])
}

model GenerationLock {
  projectId      String   @id
  idempotencyKey String   @unique
  acquiredAt     DateTime @default(now())
  expiresAt      DateTime
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Term {
  id            String   @id @default(cuid())
  term          String
  normalizedKey String   @unique
  definition    String
  category      String
  source        String   @default("CURATED_20260906")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([term])
  @@index([category])
}
