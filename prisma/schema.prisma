generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                        String            @id @default(cuid())
  concept                   String
  audience                  String
  purpose                   String
  style                     String
  memo                      String?
  status                    String            @default("DRAFT")
  selectedScenarioVersionId String?           @unique
  selectedScenarioVersion   ScenarioVersion?  @relation("SelectedScenarioVersion", fields: [selectedScenarioVersionId], references: [id])
  scenarioVersions          ScenarioVersion[] @relation("ProjectScenarioVersions")
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
}

model ScenarioVersion {
  id                String    @id @default(cuid())
  projectId         String
  version           Int
  term              String
  english           String?
  title             String
  audience          String
  coreMessage       String
  background        String
  characterGuide    String
  panelsJson        String
  finalCaption      String
  sourceModel       String
  sourceResponseId  String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  project           Project   @relation("ProjectScenarioVersions", fields: [projectId], references: [id], onDelete: Restrict)
  selectedForProject Project? @relation("SelectedScenarioVersion")

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

model Term {
  id            String   @id @default(cuid())
  term          String
  normalizedKey String   @unique
  definition    String
  category      String
  source        String   @default("CURATED_20260906")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([term])
  @@index([category])
}
