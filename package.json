    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.8",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.1",
